APP_NAME="Manager Library"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

LOG_CHANNEL=stderr
LOG_LEVEL=info

# Base PostgreSQL 16 (la levanta docker-compose.dev.yml; en producción la pone infra)
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=library
DB_USERNAME=library
DB_PASSWORD=library

SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync

# Contraseñas con Argon2id (D-09)
HASH_DRIVER=argon2id

# Secretos: definir en .env real (nunca en el repo). JWT_SECRET con 32+ caracteres.
JWT_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

COVERS_DIR=
CORS_ORIGIN=http://localhost:5173
